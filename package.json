{
  "name": "fitpulse-api",
  "version": "1.0.0",
  "private": true,
  "description": "FitPulse API for the five-table db_proyecto schema",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:setup": "node scripts/setup-database.js",
    "db:seed": "node scripts/seed-database.js",
    "test": "node tests/integration.js",
    "db:demo": "node scripts/seed-demo.js",
    "db:migrate-passwords": "node scripts/migrate-passwords.js",
    "test:passwords": "node --test tests/passwords.test.js",
    "test:credential-tools": "node tests/credential-tools.js"
  },
  "dependencies": {
    "argon2": "^0.44.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.15.3",
    "swagger-ui-express": "^5.0.1"
  }
}
